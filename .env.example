# Copia este fichero como ".env" (en la raíz del proyecto) y cambia las contraseñas.
# Lo leen docker-compose.yml (para crear la base de datos) y application.properties (para conectarse).
DB_DRIVER=org.mariadb.jdbc.Driver
DB_URL=jdbc:mariadb://localhost:3306/publicaciones
DB_DATABASE=publicaciones
DB_USER=myuser
DB_PASSWORD=cambiame
DB_ROOT_PASSWORD=cambiame_root
